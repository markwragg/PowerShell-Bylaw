# Bylaw output must be byte-identical on every OS (ADR-0009), so the repository
# stores and checks out all text with LF, regardless of core.autocrlf.
* text=auto eol=lf

*.ps1   text eol=lf
*.psm1  text eol=lf
*.psd1  text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.json  text eol=lf

# Golden files are compared byte for byte: never let Git transform them.
tests/Golden/**/*.json -text
examples/**/*.json     -text

*.png binary
*.jpg binary
*.gif binary
