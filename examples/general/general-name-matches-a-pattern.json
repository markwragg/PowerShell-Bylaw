{
  "$schema": "https://raw.githubusercontent.com/Azure/enterprise-azure-policy-as-code/main/Schemas/policy-definition-schema.json",
  "name": "general-name-matches-a-pattern",
  "properties": {
    "displayName": "Resource names match an allowed pattern",
    "policyType": "Custom",
    "mode": "Indexed",
    "metadata": {
      "version": "1.0.0",
      "category": "General"
    },
    "parameters": {
      "namePatterns": {
        "type": "Array",
        "metadata": {
          "displayName": "Name patterns",
          "description": "Patterns a resource name can match, each with at most one *."
        },
        "defaultValue": [
          "rg-*",
          "st*"
        ]
      },
      "effect": {
        "type": "String",
        "metadata": {
          "displayName": "Effect",
          "description": "Enable or disable the execution of the policy"
        },
        "allowedValues": [
          "Audit",
          "Deny",
          "Disabled"
        ],
        "defaultValue": "Audit"
      }
    },
    "policyRule": {
      "if": {
        "count": {
          "value": "[parameters('namePatterns')]",
          "name": "pattern",
          "where": {
            "field": "name",
            "like": "[current('pattern')]"
          }
        },
        "lessOrEquals": 0
      },
      "then": {
        "effect": "[parameters('effect')]"
      }
    }
  }
}
