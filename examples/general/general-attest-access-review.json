{
  "$schema": "https://raw.githubusercontent.com/Azure/enterprise-azure-policy-as-code/main/Schemas/policy-definition-schema.json",
  "name": "general-attest-access-review",
  "properties": {
    "displayName": "Privileged access to subscriptions is reviewed every quarter",
    "policyType": "Custom",
    "mode": "All",
    "description": "Owners attest that the quarterly review of privileged role assignments has been done.",
    "metadata": {
      "version": "1.0.0",
      "category": "General"
    },
    "parameters": {
      "effect": {
        "type": "String",
        "metadata": {
          "displayName": "Effect",
          "description": "Enable or disable the execution of the policy"
        },
        "allowedValues": [
          "Manual",
          "Disabled"
        ],
        "defaultValue": "Manual"
      }
    },
    "policyRule": {
      "if": {
        "field": "type",
        "equals": "Microsoft.Resources/subscriptions"
      },
      "then": {
        "effect": "[parameters('effect')]",
        "details": {
          "defaultState": "Non-compliant"
        }
      }
    }
  }
}
