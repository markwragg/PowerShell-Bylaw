{
  "name": "plain-count",
  "properties": {
    "displayName": "Plain: storage firewalls have at least one IP rule",
    "policyType": "Custom",
    "mode": "Indexed",
    "policyRule": {
      "if": {
        "allOf": [
          {
            "field": "type",
            "equals": "Microsoft.Storage/storageAccounts"
          },
          {
            "count": {
              "field": "Microsoft.Storage/storageAccounts/networkAcls.ipRules[*]"
            },
            "lessOrEquals": 0
          }
        ]
      },
      "then": {
        "effect": "Audit"
      }
    }
  }
}
