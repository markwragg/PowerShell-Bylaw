{
  "name": "plain-auditifnotexists",
  "properties": {
    "displayName": "Plain: virtual machines have an extension from Microsoft",
    "policyType": "Custom",
    "mode": "Indexed",
    "policyRule": {
      "if": {
        "field": "type",
        "equals": "Microsoft.Compute/virtualMachines"
      },
      "then": {
        "effect": "AuditIfNotExists",
        "details": {
          "type": "Microsoft.Compute/virtualMachines/extensions",
          "existenceCondition": {
            "field": "Microsoft.Compute/virtualMachines/extensions/publisher",
            "like": "Microsoft.*"
          }
        }
      }
    }
  }
}
